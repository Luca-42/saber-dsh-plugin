{
  "name": "dsh-plugin-saber",
  "version": "0.2.0",
  "description": "DSH plugin: drive a local Saber-Translator manga translator through its HTTP API (translate, jobs, images, glossary, backend lifecycle).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "saber-translator",
    "manga",
    "translator",
    "comic"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luca-42/saber-dsh-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Luca-42/saber-dsh-plugin/issues"
  },
  "homepage": "https://github.com/Luca-42/saber-dsh-plugin#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
